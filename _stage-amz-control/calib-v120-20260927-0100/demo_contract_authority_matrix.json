    {"id": "A-VERIFICATION", "name": "逐事实 VerificationResult", "may_write": ["system.deterministic", "system.model", "user"], "cannot_prove": ["商业审美", "结论前提之外的场景"]},
    {"id": "A-VISUALREVIEW", "name": "人工 VisualReview", "may_write": ["user"], "cannot_prove": ["商品事实", "平台技术形态"]},
