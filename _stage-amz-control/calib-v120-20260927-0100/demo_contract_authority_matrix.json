    {"id": "A-COPY", "name": "已确认文案", "may_write": ["user"], "cannot_prove": ["文案是否被平台允许", "商品事实"]},
    {"id": "A-LAYOUT", "name": "版式规格", "may_write": ["user", "system.deterministic"], "cannot_prove": ["商品事实", "平台合规"]},
    {"id": "A-COMPOSITION", "name": "CompositionVersion（确定性合成结果）", "may_write": ["system.deterministic"], "cannot_prove": ["商品事实", "审美好不好"]},
    {"id": "A-PLAN", "name": "已确认的 PlanVersion", "may_write": ["user"], "proposed_by": ["system.model", "system.deterministic"], "cannot_prove": ["模型一定能产出该图"]},
    {"id": "A-EXPORT", "name": "平台与导出规则", "may_write": ["system.deterministic"], "cannot_prove": ["Amazon 实际审核通过"]}
