    {"id": "A-PROMPT", "name": "PromptVersion（实际发送文本）", "may_write": ["user", "system.deterministic"], "cannot_prove": ["保真", "模型是否照做"]},
    {"id": "A-MODELCFG", "name": "模型与采样参数配置", "may_write": ["user", "system.deterministic"], "cannot_prove": ["输出质量", "商品身份"]},
    {"id": "A-BUDGET", "name": "预算与外发授权", "may_write": ["user"], "cannot_prove": ["这笔花费是否值得"]},
    {"id": "A-RUN", "name": "Attempt 身份与 provider task id", "may_write": ["system.deterministic", "external.provider"], "cannot_prove": ["图片内容是否正确", "商品事实"]},
    {"id": "A-CANDIDATE", "name": "不可覆盖的候选文件", "may_write": ["system.deterministic"], "cannot_prove": ["商品身份", "平台合规", "是否好看"]},
