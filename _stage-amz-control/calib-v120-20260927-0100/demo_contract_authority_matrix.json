  "fact_class_responsibility": [
    {
      "fact_type": "文件、格式、哈希、尺寸和平台规则",
      "verifier_kinds": ["deterministic_rule"],
      "boundary": "可复现输入上可直接 pass/fail；换输入必须重跑，不能沿用上一次结论"
    },
    {
      "fact_type": "文字、标识和水印",
      "verifier_kinds": ["reference_conditioned_vision", "explicit_human_fact_confirmation"],
      "boundary": "未经对照验证的模型只报风险或转人工；文字的措辞强度不构成保证"
    },
    {
      "fact_type": "颜色、比例和轮廓",
      "verifier_kinds": ["segmentation_or_local_match", "reference_conditioned_vision", "explicit_human_fact_confirmation"],
      "boundary": "分割只定位不证明身份；位置、中心和类别形状只能作弱先验，前提不成立即 Unknown"
    },
    {
      "fact_type": "部件、结构和相互关系",
      "verifier_kinds": ["reference_conditioned_vision", "explicit_human_fact_confirmation"],
      "boundary": "不能用单一阈值掩膜替代语义判断；结构类结论必须有人确认或明确 Unknown"
    },
    {
      "fact_type": "构图、光线、材质感和商业完成度",
      "verifier_kinds": ["human_visual_review"],
      "boundary": "只输出 keep / redo / reject 及具体理由，不伪造客观总分，也不能覆盖事实失败"
    }
  ]
