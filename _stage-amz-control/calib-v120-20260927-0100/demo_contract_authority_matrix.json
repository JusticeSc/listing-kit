  "authorities": [
    {"id": "A-ASSET", "name": "商品包 manifest 与文件哈希", "may_write": ["user"], "cannot_prove": ["包里的图片是否与实物一致", "材质、容量、功能与认证"]},
    {"id": "A-POLICY", "name": "项目数据与外发政策", "may_write": ["user", "system.deterministic"], "cannot_prove": ["把参考图外发是否值得", "模型质量"]},
    {"id": "A-SPEC", "name": "用户提供的规格与卖点资料", "may_write": ["user"], "cannot_prove": ["资料里没写的事实", "卖点是否被图片证实"]},
    {"id": "A-REFIMG", "name": "参考商品图", "may_write": ["user"], "cannot_prove": ["材质、容量、功能、认证", "真实颜色与拍摄参数"]},
    {"id": "A-FACTS", "name": "已确认的 FactsVersion", "may_write": ["user", "system.deterministic"], "cannot_prove": ["图片中未覆盖的隐含事实", "未确认字段"]},
    {"id": "A-PLATFORM", "name": "Amazon US 平台规则与 slots 配置", "may_write": ["system.deterministic"], "cannot_prove": ["画面是否好看", "商品身份是否一致"]},
    {"id": "A-USERGOAL", "name": "用户本次任务目标", "may_write": ["user"], "cannot_prove": ["技术可行性", "平台是否允许"]},
