    {"id": "A-SHOTSPEC", "name": "ShotSpec（单张图的业务意图）", "may_write": ["user"], "proposed_by": ["system.model", "system.deterministic"], "cannot_prove": ["商品事实", "模型一定能生成出来"]},
    {"id": "A-STYLE", "name": "StyleSpec（共享视觉方向）", "may_write": ["user"], "proposed_by": ["system.model", "system.deterministic"], "cannot_prove": ["商品事实", "身份保真"]},
