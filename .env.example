# 复制为 .env 后填写。run.py 会自动加载。

# ---- Product V2 百炼模型 ----
# 语义理解与图片生成均使用这一个百炼 API Key；不要提交真实值。
DASHSCOPE_API_KEY=

# 默认档开关（V2.R4.3，缺省 fail-closed）：未设置/0/false/closed/off = 部署密钥不进
# 真实模型调用（图像网关与语义/复核路由一致 503 PROVIDER_NOT_CONFIGURED）；
# 1/true/open/on = 允许沿用部署密钥；BYOK 请求头（X-AMZ-Listing-Key-Image）不依赖本开关。
# AMZ_V2_DEFAULT_TRIAL=open

# 第二真实图像 provider（火山 Ark）的运行环境接线（R4.3 只接线，R5.2 落适配器本体）；
# CI 同步步骤在仓库 Secret 配好 ARK_API_KEY 后会把该值写进远程 app.env。
#
# V2.R5.2 起，volcengine-ark 是有效的同步协议 Adapter：
#   - 注册表 id / 适配器：volcengine-ark / v2_volcengine_image（config/product-v2/providers.json）
#   - 模型：doubao-seedream-5-0-flash-260915（同步 images/generations，b64_json + png）
#   - 端点：默认 https://ark.cn-beijing.volces.com/api/v3（覆盖用 AMZ_V2_ARK_BASE_URL）
#   - 超时：默认 90 秒（覆盖用 AMZ_V2_ARK_TIMEOUT；同步一次等图）
#   - 出站白名单：volces.com 与 aliyuncs.com（DEFAULT_ALLOWED_HOSTS）
#   - provider 选择：AMZ_V2_IMAGE_PROVIDER=volcengine-ark
# ARK_API_KEY=
# AMZ_V2_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AMZ_V2_ARK_TIMEOUT=90
# AMZ_V2_IMAGE_PROVIDER=volcengine-ark

# V2 首版语义模型；通过 SemanticProvider 适配。
SEMANTIC_MODEL=deepseek-v4.1-flash

# 可选：切换生成模型档位（也可用命令行 --model 指定，优先级更高）
#   qwen-image-3.0       默认。单边支持到 2048，可原生出 1600px；中文文字渲染强
#   qwen-image-3.0-pro   更贵更慢，画质更好；正式发布版可用
#   wanx2.1-t2i-turbo    旧模型族，上限 1024（导出到 1600 需放大）
IMAGE_MODEL=qwen-image-3.0

# V2.5.2 选择视觉校验 Provider 后再填写；空值表示尚未启用 VLM 校验。
VLM_MODEL=

# ---- legacy v2 / Product V1 抠图兼容配置 ----
# Product V2 主流程不使用抠图模型；以下仅供旧入口回归。
# auto       优先 rembg，本地没模型就直接降级 floodfill（不会去联网下载、不会等超时）
# rembg      强制 rembg（模型不在本地则降级）
# floodfill  强制零依赖洪水填充
CUTOUT_MODE=auto

# rembg 模型目录（<目录>/<会话名>.onnx）。放在本地盘，避免下载与占 C 盘。
# 目前用的是 BiRefNet-general-lite，与 rembg 官方模型 md5 一致（4fab47ad…e66334）。
REMBG_MODEL_DIR=E:\model_repository\model_scope\rembg

# 会话名；不填默认 birefnet-general-lite，找不到会依次退到 u2net，再退 floodfill
# REMBG_SESSION=birefnet-general-lite
